{
  "name": "@chronos-ui/core",
  "version": "1.1.4",
  "description": "A universal, framework-agnostic UI component library built with Mitosis. Write once, compile to React, Svelte, and Web Components.",
  "author": "your-name",
  "license": "MIT",
  "homepage": "https://nilkoushik.github.io/chronos-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilkoushik/chronos-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nilkoushik/chronos-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ui",
    "components",
    "mitosis",
    "react",
    "svelte",
    "web-components",
    "banner",
    "slider",
    "cms",
    "headless"
  ],
  "files": [
    "dist/",
    "src/styles/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/react/src/components/index.js",
    "./theme.css": "./src/styles/theme.css",
    "./styles/*": "./src/styles/*",
    "./react/*": "./dist/react/src/components/*.js",
    "./svelte/*": "./dist/svelte/src/components/*",
    "./webcomponent/*": "./dist/webcomponent/dist/*"
  },
  "main": "./dist/react/src/components/index.js",
  "scripts": {
    "build": "npx mitosis build && node fix-styles.js && node fix-props.js && node fix-react.js && node fix-wc-props.js && node build-wc.js && node fix-wc-onmount.js",
    "docs": "node scripts/generate-docs.js",
    "postbuild": "npm run docs",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm run build",
    "postpublish": "node -e \"if (process.env.CI !== 'true' && process.env.GITHUB_ACTIONS !== 'true') require('./scripts/sync-beta-tag.js')\"",
    "release": "semantic-release",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@builder.io/mitosis": "^0.13.0",
    "@builder.io/mitosis-cli": "^0.13.0",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "typescript": "^6.0.3"
  }
}
