{
  "name": "@chronos-ui/core",
  "version": "1.0.0-beta.15",
  "description": "A universal, framework-agnostic UI component library built with Mitosis. Write once, compile to React, Svelte, and Web Components.",
  "author": "your-name",
  "license": "MIT",
  "homepage": "https://nilkoushik.github.io/chronos-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilkoushik/chronos-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nilkoushik/chronos-ui/issues"
  },
  "keywords": [
    "ui",
    "components",
    "mitosis",
    "react",
    "svelte",
    "web-components",
    "banner",
    "slider",
    "cms",
    "headless"
  ],
  "files": [
    "dist/",
    "src/styles/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./react":          "./dist/react/src/components",
    "./svelte":         "./dist/svelte/src/components",
    "./webcomponents":  "./dist/webcomponent/dist",
    "./theme.css":      "./src/styles/theme.css",
    "./svelte/*":       "./dist/svelte/src/components/*"
  },
  "main": "./dist/react/src/components/index.js",
  "types": "./dist/react/src/components/index.d.ts",
  "scripts": {
    "build": "npx mitosis build && node fix-styles.js && node fix-props.js && node fix-wc-props.js && node build-wc.js",
    "docs": "node scripts/generate-docs.js",
    "postbuild": "npm run docs",
    "prepublishOnly": "npm run build",
    "version": "git add -A",
    "postversion": "git push && git push --tags",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@builder.io/mitosis": "^0.13.0",
    "@builder.io/mitosis-cli": "^0.13.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
